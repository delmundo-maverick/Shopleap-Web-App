APP_NAME=Shopleap
APP_ENV=local
APP_DEBUG=true
APP_KEY=
# The web address of this server. The Flutter app uses its own base URL (see notes below).
APP_URL=http://localhost:8000
MAIN_BASE_URL=https://shopleap.shop
LOGISTICS_BASE_URL=https://logistics.shopleap.shop
# Local: use http://localhost:8000 and http://logistics.localhost:8000 above.
# Defaults to MAIN_BASE_URL; set this when moving the admin portal.
ADMIN_BASE_URL=${MAIN_BASE_URL}
# Set both to true on Render.
PORTAL_FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
ADDITIONAL_ALLOWED_HOSTS=
# LOGISTICS_SUPPORT_EMAIL= (defaults to MAIL_FROM_ADDRESS)
APP_TIMEZONE=Asia/Manila

# Local: write to storage/logs/laravel.log so you can read OTP emails and API errors.
# On a host that collects stderr (for example Render), use LOG_CHANNEL=stderr instead.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
# If set, this overrides DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD.
# Copy the transaction pooler URI from Supabase Connect; URL-encode its password.
DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Courier registration data waits here for the OTP, and API rate limits use it. The cache table must exist.
CACHE_STORE=database
# In production, use a shared Redis store for cache, rate limits and sessions.
CACHE_LIMITER_STORE=database
# PSGC reference lists use local files to avoid database-backed cache queries.
PSGC_CACHE_STORE=file
# sync = OTP emails send immediately. Use "database" only with a worker running (see notes).
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=r2_public

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=shopleap-private
R2_PUBLIC_BUCKET=shopleap-public
R2_PUBLIC_URL=https://your-public-assets.example.com

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Shopleap"

# Optional courier token lifetime in minutes. Empty means no global expiry.
SANCTUM_EXPIRATION=

# Set these explicitly on Render; generate APP_KEY once and keep it stable.
# APP_ENV=production
# APP_DEBUG=false
# LOG_CHANNEL=stderr
# LOG_LEVEL=warning
# MAIL_MAILER must be a delivery transport, never log or failover-to-log.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,logistics.localhost:8000
